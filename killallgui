-- Count selected targets
local function CountSelectedTargets()
    local count = 0
    for _ in pairs(SelectedTargets) do
        count = count + 1
    end
    return count
end

-- Update status display
local function UpdateStatus()
    local count = CountSelectedTargets()
    if KillActive then
        StatusLabel.Text = "🔪 Убиваем " .. count .. " целей..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    else
        StatusLabel.Text = count .. " целей выбрано"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end

-- Toggle all players
local function ToggleAllPlayers(select)
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            local checkboxData = PlayerCheckboxes[target.Name]
            if checkboxData then
                if select then
                    SelectedTargets[target.Name] = target
                    checkboxData.Checkmark.Visible = true
                else
                    SelectedTargets[target.Name] = nil
                    checkboxData.Checkmark.Visible = false
                end
            end
        end
    end
    UpdateStatus()
end

-- Kill function (from your script)
local function KillTarget(target)
    local char = player.Character or player.CharacterAdded:Wait()
    local knife = char:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
    
    if knife and knife.Parent == player.Backpack then
        knife.Parent = char
    end
    
    if knife and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        knife:Activate()
        firetouchinterest(target.Character.HumanoidRootPart, knife.Handle, 0)
        task.wait(0.02)
        firetouchinterest(target.Character.HumanoidRootPart, knife.Handle, 1)
        return true
    end
    return false
end

-- Start killing
local function StartKill()
    if KillActive then return end
    
    local count = CountSelectedTargets()
    if count == 0 then
        StatusLabel.Text = "⚠️ Нет выбранных целей!"
        task.wait(1)
        UpdateStatus()
        return
    end
    
    KillActive = true
    UpdateStatus()
    StartButton.BackgroundColor3 = Color3.fromRGB(100, 200, 0)
    StartButton.Text = "🟢 KILLING..."
    
    -- Start kill loop
    KillThread = task.spawn(function()
        while KillActive do
            local validTargets = {}
            
            -- Get valid targets
            for name, target in pairs(SelectedTargets) do
                if target and target.Parent then
                    validTargets[name] = target
                else
                    SelectedTargets[name] = nil
                    local checkbox = PlayerCheckboxes[name]
                    if checkbox then
                        checkbox.Checkmark.Visible = false
                    end
                end
            end
            
            -- Kill each target
            for _, target in pairs(validTargets) do
                if KillActive then
                    pcall(function()
                        KillTarget(target)
                    end)
                    task.wait(0.15)
                else
                    break
                end
            end
            
            UpdateStatus()
            task.wait(0.1)
        end
    end)
end

-- Stop killing
local function StopKill()
    KillActive = false
    if KillThread then
        KillThread = nil
    end
    StartButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
    StartButton.Text = "🔴 START KILL"
    UpdateStatus()
end

